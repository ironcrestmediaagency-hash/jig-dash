{
  "name": "jig-deal-analyzer",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "DB", "id": "PASTE_KV_ID_HERE" },
    { "binding": "CACHE", "id": "PASTE_KV_ID_HERE" }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
